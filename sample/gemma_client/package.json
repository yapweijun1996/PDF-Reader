{
  "name": "gemma-client",
  "version": "1.0.0",
  "description": "Browser-based Gemini API client with XOR key management and prompt-based function calling for Gemma models",
  "type": "module",
  "main": "dist/gemma_client.js",
  "scripts": {
    "test": "node test/run_all.js",
    "test:unit": "node test/run_all.js --unit",
    "test:live": "node test/run_all.js --live",
    "test:e2e": "node test/run_all.js --regression",
    "test:complex": "node test/run_all.js --complex",
    "test:longconv": "node test/run_all.js --longconv",
    "test:stress": "node test/run_all.js --stress",
    "test:ability": "node test/run_all.js --ability",
    "knowledge:chunks": "node scripts/build_knowledge_chunks.js",
    "knowledge:embeddings": "node scripts/build_knowledge_embeddings.js",
    "knowledge": "npm run knowledge:chunks && npm run knowledge:embeddings",
    "build": "esbuild src/index.js --bundle --format=iife --global-name=GemmaClient --outfile=dist/gemma_client.js --target=es2018",
    "build:min": "esbuild src/index.js --bundle --format=iife --global-name=GemmaClient --outfile=dist/gemma_client.min.js --target=es2018 --minify",
    "watch": "esbuild src/index.js --bundle --format=iife --global-name=GemmaClient --outfile=dist/gemma_client.js --target=es2018 --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
